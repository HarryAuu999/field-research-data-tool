{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harryauu999.github.io/field-research-data-tool/docs/questionnaire.schema.json",
  "title": "AuNote questionnaire schemaVersion 1",
  "description": "AuNote可导入问卷。JSON Schema用于导入前预检，运行时仍由validateTemplate()验证。",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "title", "fields"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/nonEmptyString" },
    "version": { "$ref": "#/$defs/nonEmptyString" },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "description": { "type": "string" },
    "recordLabelField": {
      "$ref": "#/$defs/nonEmptyString",
      "description": "样本列表中用作样本名称的题目ID；省略时AuNote按兼容规则自动选择。"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/field" }
    },
    "analysis": { "$ref": "#/$defs/analysis" },
    "analyses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/analysis" },
      "description": "新版多模块分析配置，不能与旧字段 analysis 同时使用。"
    },
    "key": { "type": "string", "readOnly": true },
    "importedAt": { "type": "string", "format": "date-time", "readOnly": true }
  },
  "additionalProperties": false,
  "allOf": [{ "not": { "required": ["analysis", "analyses"] } }],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "image": {
      "type": "object",
      "required": ["src"],
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^(data:image/|\\./assets/)"
        },
        "alt": { "type": "string" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "annotationImage": {
      "allOf": [
        { "$ref": "#/$defs/image" },
        { "required": ["src", "width", "height"] }
      ]
    },
    "textInput": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "placeholder": { "type": "string" },
        "required": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "imageAngleConfig": {
      "type": "object",
      "required": ["center", "zeroDegrees", "rotation", "min", "max", "step", "radius"],
      "properties": {
        "center": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
        "zeroDegrees": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "rotation": { "enum": ["clockwise", "counterclockwise"] },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      },
      "description": "限界二维角度。max须大于min且跨度不超过180°；step须等分范围。zeroDegrees以向右0°、向上90°定义。运行时校验跨字段约束。",
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "exclusive": { "type": "boolean", "default": false },
        "textInput": { "$ref": "#/$defs/textInput" }
      },
      "additionalProperties": false
    },
    "ratingLabel": {
      "type": "object",
      "properties": {
        "short": { "type": "string" },
        "help": { "type": "string" }
      },
      "additionalProperties": false
    },
    "commonField": {
      "type": "object",
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "type": "string" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "type": "string" },
        "required": { "type": "boolean", "default": false },
        "page": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "相邻题目使用相同page时显示在同一页；省略时该题独占一页。"
        },
        "image": { "$ref": "#/$defs/image" }
      }
    },
    "field": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/commonField" },
            {
              "properties": {
                "type": { "const": "shortText" },
                "placeholder": { "type": "string" },
                "allowAnonymous": { "type": "boolean", "default": false },
                "anonymousLabel": { "type": "string", "default": "匿名" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/commonField" },
            {
              "properties": {
                "type": { "const": "longText" },
                "placeholder": { "type": "string" },
                "allowAnonymous": { "type": "boolean", "default": false },
                "anonymousLabel": { "type": "string", "default": "匿名" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/commonField" },
            {
              "properties": {
                "type": { "const": "number" },
                "placeholder": { "type": "string" },
                "unit": { "type": "string" },
                "integer": { "type": "boolean", "default": false }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/commonField" },
            {
              "required": ["repeatCount"],
              "properties": {
                "type": { "const": "repeatedNumber" },
                "repeatCount": { "type": "integer", "minimum": 2, "maximum": 10 },
                "minEntries": { "type": "integer", "minimum": 0, "maximum": 10 },
                "placeholder": { "type": "string" },
                "unit": { "type": "string" },
                "integer": { "type": "boolean", "default": false }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/commonField" },
            {
              "required": ["options"],
              "properties": {
                "type": { "const": "singleChoice" },
                "options": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/option" }
                }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/commonField" },
            {
              "required": ["options"],
              "properties": {
                "type": { "const": "multiChoice" },
                "options": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/option" }
                }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/commonField" },
            {
              "required": ["min", "max"],
              "properties": {
                "type": { "const": "rating" },
                "min": { "type": "integer", "description": "必须小于max；该跨字段关系继续由validateTemplate()检查。" },
                "max": { "type": "integer", "description": "必须大于min；该跨字段关系继续由validateTemplate()检查。" },
                "unknownOption": {
                  "type": "object",
                  "required": ["id", "label"],
                  "properties": {
                    "id": { "$ref": "#/$defs/nonEmptyString" },
                    "label": { "$ref": "#/$defs/nonEmptyString" }
                  },
                  "additionalProperties": false
                },
                "labels": {
                  "type": "object",
                  "propertyNames": { "pattern": "^-?\\d+$" },
                  "additionalProperties": { "$ref": "#/$defs/ratingLabel" }
                }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/commonField" },
            {
              "required": ["image", "view", "annotationType", "brushSize", "levels"],
              "properties": {
                "type": { "const": "imageRange" },
                "questionNumber": { "type": "integer", "minimum": 1 },
                "image": { "$ref": "#/$defs/annotationImage" },
                "view": { "$ref": "#/$defs/nonEmptyString" },
                "annotationType": { "$ref": "#/$defs/nonEmptyString" },
                "brushSize": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.2 },
                "levels": {
                  "type": "array", "minItems": 1, "maxItems": 2,
                  "items": { "type": "object", "required": ["id", "label"], "properties": { "id": { "type": "integer", "minimum": 1, "maximum": 2 }, "label": { "$ref": "#/$defs/nonEmptyString" } }, "additionalProperties": false }
                }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/commonField" },
            {
              "required": ["image", "angle"],
              "not": { "required": ["page"] },
              "properties": {
                "type": { "const": "imageAngle" },
                "image": { "$ref": "#/$defs/annotationImage" },
                "angle": { "$ref": "#/$defs/imageAngleConfig" }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/commonField" },
            { "properties": { "type": { "const": "section" } } }
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "analysisField": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "theme": { "enum": ["blue", "orange"] }
      },
      "additionalProperties": false
    },
    "analysisProperties": {
      "aggregation": { "const": "participantMean" },
      "binWidth": { "type": "number", "exclusiveMinimum": 0 },
      "percentiles": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 100 }
      },
      "statistics": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": ["count", "mean", "median", "mode", "min", "max", "sd", "q1", "q3"]
        }
      },
      "fields": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/analysisField" }
      }
    },
    "analysis": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "aggregation", "percentiles", "fields"],
          "properties": {
            "type": { "const": "distribution" },
            "aggregation": { "$ref": "#/$defs/analysisProperties/aggregation" },
            "binWidth": { "$ref": "#/$defs/analysisProperties/binWidth" },
            "percentiles": { "$ref": "#/$defs/analysisProperties/percentiles" },
            "statistics": { "$ref": "#/$defs/analysisProperties/statistics" },
            "fields": { "$ref": "#/$defs/analysisProperties/fields" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "aggregation", "fields"],
          "properties": {
            "type": { "const": "descriptiveDistribution" },
            "aggregation": { "$ref": "#/$defs/analysisProperties/aggregation" },
            "binWidth": { "$ref": "#/$defs/analysisProperties/binWidth" },
            "percentiles": { "$ref": "#/$defs/analysisProperties/percentiles" },
            "statistics": { "$ref": "#/$defs/analysisProperties/statistics" },
            "fields": { "$ref": "#/$defs/analysisProperties/fields" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "fields"],
          "properties": {
            "type": { "const": "imageRangeHeatmap" },
            "fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "label": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "fields"],
          "properties": {
            "type": { "const": "categoricalFrequency" },
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": { "$ref": "#/$defs/nonEmptyString" },
                  "label": { "$ref": "#/$defs/nonEmptyString" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "binWidth", "fields"],
          "properties": {
            "type": { "const": "angleDistribution" },
            "binWidth": { "type": "number", "exclusiveMinimum": 0, "description": "须等分每个目标字段的角度范围，最多180组；由运行时进一步校验。" },
            "fields": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "required": ["id"],
                "properties": { "id": { "$ref": "#/$defs/nonEmptyString" }, "label": { "$ref": "#/$defs/nonEmptyString" } },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
